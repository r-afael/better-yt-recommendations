{
  "name": "better-yt-recommendations",
  "version": "1.3.0",
  "private": true,
  "description": "Make Your custom feed the default YouTube homepage tab and hide off-topic recommendations.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**/*.js\" --test-coverage-exclude=\"src/vendor/**\" --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 \"test/*.test.js\"",
    "lint": "eslint .",
    "vendor": "node scripts/vendor.js",
    "check": "for file in src/*.js; do node --check \"$file\" || exit 1; done && eslint . && pnpm coverage"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@huggingface/transformers": "4.3.1",
    "@sinonjs/fake-timers": "15.4.0",
    "eslint": "10.13.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.13.0",
    "jsdom": "30.1.3"
  }
}
