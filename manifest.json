{
  "manifest_version": 3,
  "name": "Better YT Recommendations",
  "version": "1.5.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "src/icons/icon-16.png",
    "32": "src/icons/icon-32.png",
    "48": "src/icons/icon-48.png",
    "128": "src/icons/icon-128.png"
  },
  "permissions": ["storage", "offscreen", "contextMenus", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_icon": {
      "16": "src/icons/icon-16.png",
      "32": "src/icons/icon-32.png",
      "48": "src/icons/icon-48.png",
      "128": "src/icons/icon-128.png"
    },
    "default_popup": "src/popup.html"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-topic-filter": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "MacCtrl+Shift+F",
        "chromeos": "Alt+Shift+F"
      },
      "description": "__MSG_commandToggleFilter__"
    },
    "toggle-hide-shorts": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "MacCtrl+Shift+S",
        "chromeos": "Alt+Shift+H"
      },
      "description": "__MSG_commandToggleShorts__"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "shorts_redirect",
        "enabled": false,
        "path": "src/rules/shorts-redirect.json"
      }
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
      "js": ["src/settings.js", "src/shorts.js"],
      "css": ["src/shorts.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
      "js": [
        "src/scheduler.js",
        "src/labels.js",
        "src/cards.js",
        "src/content.js",
        "src/protocol.js",
        "src/topics.js",
        "src/verdict.js",
        "src/channels.js",
        "src/hidden-row.js",
        "src/toast.js",
        "src/channel-menu.js",
        "src/filter.js"
      ],
      "css": ["src/filter.css"],
      "run_at": "document_idle"
    }
  ]
}
